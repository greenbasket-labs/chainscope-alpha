# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Minimum 32 random characters.
# Used to encrypt wallet private keys at rest (AES-256-GCM).
SESSION_SECRET=change-me-in-production-use-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Directory where alpha.db is stored.
# Defaults to <cwd>/data when unset.
# On Render: set to the mount path of your persistent disk, e.g. /var/data
DATA_ROOT=/var/data

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your frontend domain in production, e.g. https://alpha.yourdomain.com
# Leave as * for local development.
ALLOWED_ORIGIN=*

# ── Logging ───────────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── MINTLINE bridge ──────────────────────────────────────────────────────────
# Disabled by default. Set true only when you want passed ChainScope alerts
# forwarded to the MINTLINE external CA intake endpoint.
MINTLINE_BRIDGE_ENABLED=false
MINTLINE_API_URL=https://YOUR-MINTLINE-RENDER-URL.onrender.com
MINTLINE_API_KEY=change-me
# Paper/test balance supplied to the external intake adapter.
MINTLINE_EXTERNAL_WALLET_BALANCE_SOL=1
