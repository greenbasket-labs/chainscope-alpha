# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Minimum 32 random characters.
# Used to encrypt wallet private keys at rest (AES-256-GCM).
SESSION_SECRET=change-me-in-production-use-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Directory where alpha.db is stored.
# Defaults to <cwd>/data when unset.
# On Render: set to the mount path of your persistent disk, e.g. /var/data
DATA_ROOT=/var/data

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your frontend domain in production, e.g. https://alpha.yourdomain.com
# Leave as * for local development.
ALLOWED_ORIGIN=*

# ── Logging ───────────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
